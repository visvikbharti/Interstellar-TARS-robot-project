<mujoco model="tars_wheel">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <default>
    <geom friction="0.9 0.02 0.001"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="30 30 0.1" friction="1.0 0.02 0.001" rgba="0.85 0.82 0.75 1"/>
    <light pos="0 0 3" dir="0 0 -1"/>

    <body name="hub" pos="0 0 0.2170">
      <freejoint/>
      <geom type="cylinder" size="0.0150 0.0830" euler="1.5708 0 0"
            mass="0.45" rgba="0.2 0.22 0.25 1"/>
      
      <body name="slab0" pos="0 -0.0630 0">
        <joint name="slab0_hinge" type="hinge" axis="0 1 0" limited="false"
               damping="0.05" frictionloss="0.15"/>
        <geom type="box" size="0.0275 0.0200 0.1200" pos="0 0 -0.0950" mass="0.21"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="-0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
      </body>
      <body name="slab1" pos="0 -0.0210 0">
        <joint name="slab1_hinge" type="hinge" axis="0 1 0" limited="false"
               damping="0.05" frictionloss="0.15"/>
        <geom type="box" size="0.0275 0.0200 0.1200" pos="0 0 -0.0950" mass="0.21"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="-0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
      </body>
      <body name="slab2" pos="0 0.0210 0">
        <joint name="slab2_hinge" type="hinge" axis="0 1 0" limited="false"
               damping="0.05" frictionloss="0.15"/>
        <geom type="box" size="0.0275 0.0200 0.1200" pos="0 0 -0.0950" mass="0.21"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="-0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
      </body>
      <body name="slab3" pos="0 0.0630 0">
        <joint name="slab3_hinge" type="hinge" axis="0 1 0" limited="false"
               damping="0.05" frictionloss="0.15"/>
        <geom type="box" size="0.0275 0.0200 0.1200" pos="0 0 -0.0950" mass="0.21"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="-0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- intvelocity = bus servo in continuous mode: tracks a position target
         that advances at the commanded velocity; HOLDS position at cmd=0 -->
    <intvelocity name="w0" joint="slab0_hinge" kp="60" kv="3" actrange="-1000 1000" ctrlrange="-7.0 7.0" forcerange="-1.7 1.7"/>
    <intvelocity name="w1" joint="slab1_hinge" kp="60" kv="3" actrange="-1000 1000" ctrlrange="-7.0 7.0" forcerange="-1.7 1.7"/>
    <intvelocity name="w2" joint="slab2_hinge" kp="60" kv="3" actrange="-1000 1000" ctrlrange="-7.0 7.0" forcerange="-1.7 1.7"/>
    <intvelocity name="w3" joint="slab3_hinge" kp="60" kv="3" actrange="-1000 1000" ctrlrange="-7.0 7.0" forcerange="-1.7 1.7"/>
  </actuator>
</mujoco>
