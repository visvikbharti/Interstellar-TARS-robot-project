<mujoco model="tars_v3">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <default>
    <geom friction="0.9 0.02 0.001"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="10 10 0.1" friction="1.0 0.02 0.001" rgba="0.85 0.82 0.75 1"/>
    <light pos="0 0 2" dir="0 0 -1"/>

    <body name="body" pos="0 0 0.2200">
      <freejoint/>
      <geom type="box" size="0.0275 0.0410 0.1215" pos="0 0 -0.0965" mass="0.522" rgba="0.25 0.28 0.3 1"/>
        <geom type="cylinder" size="0.0060 0.0410" pos="-0.0215 0 -0.2130" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
        <geom type="cylinder" size="0.0060 0.0410" pos="0.0215 0 -0.2130" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
      <!-- battery + Pi modelled low in the chassis -->
      <geom type="box" size="0.020 0.030 0.040" pos="0 0 -0.1640" mass="0.427" contype="0" conaffinity="0" rgba="0.2 0.5 0.3 1"/>
      
      <body name="left_leg" pos="0 -0.0630 0">
        <joint name="left_leg_lift" type="slide" axis="0 0 1" range="-0.035 0"
               damping="8" frictionloss="4"/>
        <joint name="left_leg_swing" type="hinge" axis="0 1 0" range="-1.75 1.75"
               damping="0.05" frictionloss="0.2"/>
        <geom type="box" size="0.0275 0.0200 0.1195" pos="0 0 -0.0945" mass="0.16"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="-0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
      </body>
      
      <body name="right_leg" pos="0 0.0630 0">
        <joint name="right_leg_lift" type="slide" axis="0 0 1" range="-0.035 0"
               damping="8" frictionloss="4"/>
        <joint name="right_leg_swing" type="hinge" axis="0 1 0" range="-1.75 1.75"
               damping="0.05" frictionloss="0.2"/>
        <geom type="box" size="0.0275 0.0200 0.1195" pos="0 0 -0.0945" mass="0.16"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="-0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
        <geom type="cylinder" size="0.0060 0.0200" pos="0.0215 0 -0.2090" euler="1.5708 0 0" mass="0.005" friction="1.3 0.02 0.001"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="left_lift"   joint="left_leg_lift"   kp="3000" kv="80"
              ctrlrange="-0.035 0" forcerange="-55.0 55.0"/>
    <position name="right_lift"  joint="right_leg_lift"  kp="3000" kv="80"
              ctrlrange="-0.035 0" forcerange="-55.0 55.0"/>
    <position name="left_swing"  joint="left_leg_swing"  kp="60" kv="2"
              ctrlrange="-1.75 1.75" forcerange="-2.5 2.5"/>
    <position name="right_swing" joint="right_leg_swing" kp="60" kv="2"
              ctrlrange="-1.75 1.75" forcerange="-2.5 2.5"/>
  </actuator>
</mujoco>
